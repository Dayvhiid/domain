# ============================================================
# Domain Reseller Backend - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/domain-reseller
MONGODB_URI_TEST=mongodb://localhost:27017/domain-reseller-test

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-min-32-chars-change-in-production
SESSION_COOKIE_NAME=dr_session
SESSION_COOKIE_SECURE=false  # Set to true in production (HTTPS)
SESSION_COOKIE_SAME_SITE=lax
SESSION_MAX_AGE=604800000  # 7 days in milliseconds

# -----------------------------------------------------------------------------
# Domains.co.za API Configuration
# -----------------------------------------------------------------------------
DOMAINS_USERNAME=your-reseller-username
DOMAINS_PASSWORD=your-reseller-password
DOMAINS_API_URL=https://api.domains.co.za/api

# -----------------------------------------------------------------------------
# Payment Providers Configuration (v1 - config only, webhooks in v2)
# -----------------------------------------------------------------------------

# Paystack (Nigeria/Africa) - https://paystack.com/
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# Flutterwave (Africa/Global) - https://flutterwave.com/
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret
FLUTTERWAVE_ENCRYPTION_KEY=your-32-char-encryption-key

# Payfast (South Africa) - https://www.payfast.co.za/
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=true
PAYFAST_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Email Configuration (for v2 - notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Domain Reseller Platform

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=debug  # debug, info, warn, error
ENABLE_REQUEST_LOGGING=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10  # per window for auth endpoints

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_PAYMENT_PROCESSING=false  # v1: false, v2: true
ENABLE_EMAIL_NOTIFICATIONS=false  # v1: false, v2: true
ENABLE_AUTO_RENEWAL=true

# -----------------------------------------------------------------------------
# Google OAuth Configuration
# -----------------------------------------------------------------------------
# Get credentials from: https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3002/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/api/v1/auth/oauth/google/callback